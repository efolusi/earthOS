{
  "name": "earthos",
  "version": "0.2.0",
  "description": "A real-time interactive 3D digital twin of Earth: composable globe, satellites, earthquakes, and your own data as plugins",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earthos/core": "workspace:*",
    "@earthos/gis": "workspace:*",
    "@earthos/globe": "workspace:*",
    "@earthos/plugin-aircraft": "workspace:*",
    "@earthos/plugin-daynight": "workspace:*",
    "@earthos/plugin-earthquakes": "workspace:*",
    "@earthos/plugin-eclipse": "workspace:*",
    "@earthos/plugin-geojson": "workspace:*",
    "@earthos/plugin-hurricanes": "workspace:*",
    "@earthos/plugin-imagery": "workspace:*",
    "@earthos/plugin-satellites": "workspace:*",
    "@earthos/providers": "workspace:*",
    "@earthos/ui": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.0.0 || ^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@earthos/config": "workspace:*",
    "@earthos/testing": "workspace:*",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.6.0",
    "@types/react": "^19.0.0",
    "eslint": "^9.17.0",
    "framer-motion": "^12.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.185.0",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "keywords": [
    "earth",
    "globe",
    "3d",
    "satellites",
    "three",
    "react-three-fiber",
    "digital-twin"
  ],
  "homepage": "https://earthos.efolusi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efolusi/earthOS.git",
    "directory": "sdk/earthos"
  },
  "bugs": {
    "url": "https://github.com/efolusi/earthOS/issues"
  }
}
