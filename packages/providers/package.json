{
  "name": "@earthos/providers",
  "version": "0.1.0",
  "description": "EarthOS data provider framework: SWR caching, polling, streaming, rate limits",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earthos/core": "workspace:*",
    "idb": "^8.0.0"
  },
  "devDependencies": {
    "@earthos/config": "workspace:*",
    "eslint": "^9.17.0",
    "fake-indexeddb": "^6.2.5",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://earthos.efolusi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efolusi/earthOS.git",
    "directory": "packages/providers"
  },
  "bugs": {
    "url": "https://github.com/efolusi/earthOS/issues"
  }
}
