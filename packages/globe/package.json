{
  "name": "@earthos/globe",
  "version": "0.1.0",
  "description": "EarthOS globe renderer: shader Earth, atmosphere, camera, 100k points pipeline",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earthos/core": "workspace:*",
    "@earthos/gis": "workspace:*"
  },
  "peerDependencies": {
    "@react-three/drei": "^9.0.0 || ^10.0.0",
    "@react-three/fiber": "^9.0.0",
    "react": "^19.0.0",
    "three": ">=0.170.0"
  },
  "devDependencies": {
    "@earthos/config": "workspace:*",
    "@react-three/drei": "^10.7.0",
    "@react-three/fiber": "^9.6.0",
    "@types/react": "^19.0.0",
    "@types/three": "^0.185.0",
    "eslint": "^9.17.0",
    "react": "^19.0.0",
    "three": "^0.185.0",
    "three-stdlib": "^2.36.1",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
