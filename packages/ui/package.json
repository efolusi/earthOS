{
  "name": "@earthos/ui",
  "version": "0.1.0",
  "description": "EarthOS UI kit: glass panels, layer controls, timeline, inspector, command palette",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@earthos/core": "workspace:*"
  },
  "peerDependencies": {
    "framer-motion": "^11.0.0 || ^12.0.0",
    "react": "^19.0.0"
  },
  "devDependencies": {
    "@earthos/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.17.0",
    "framer-motion": "^12.0.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.2.7"
  },
  "publishConfig": {
    "access": "public"
  }
}
