{
  "name": "@earthos/core",
  "version": "0.1.0",
  "description": "EarthOS plugin runtime: engine, plugin contract, time, workers, stores",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.react.config.ts",
    "dev": "tsup --watch",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "zustand": "^5.0.2"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@earthos/config": "workspace:*",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.0.0",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "react": "^19.0.0",
    "react-dom": "^19.2.7",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^3.0.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "homepage": "https://earthos.efolusi.com",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/efolusi/earthOS.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/efolusi/earthOS/issues"
  }
}
