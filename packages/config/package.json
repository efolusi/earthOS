{
  "name": "@earthos/config",
  "version": "0.1.0",
  "description": "Shared build, lint, and test presets for EarthOS packages and plugins",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./eslint": "./eslint/index.js",
    "./prettier": "./prettier/index.json",
    "./tsconfig/*": "./tsconfig/*",
    "./tsup-package": "./tsup/package.js",
    "./tsup-plugin": "./tsup/plugin.js",
    "./vitest": "./vitest/preset.js"
  },
  "files": [
    "eslint",
    "prettier",
    "tsconfig",
    "tsup",
    "vitest"
