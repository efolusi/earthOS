{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Safe default for Git-connected and non-main builds.
  "name": "earthos-dev",
  "workers_dev": true,
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-06-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS",
  },
  "observability": {
    "enabled": true,
  },
  "env": {
    "production": {
      "name": "earthos",
      "workers_dev": false,
      "assets": {
        "directory": ".open-next/assets",
        "binding": "ASSETS",
      },
    },
  },
  // Optional server-side secrets (wrangler secret put NAME):
  //   OPENSKY_CLIENT_ID, OPENSKY_CLIENT_SECRET
}
